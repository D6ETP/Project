# ============================================================
#   EasyTravel - Environment Variables TEMPLATE
#   Copy this file to .env and fill in your real values.
#   DO NOT put real credentials in this file!
# ============================================================

# --- MySQL Database ---
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# --- JWT Secret (32+ characters, must match auth-service AND api-gateway) ---
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# --- Gmail SMTP (Notification Service) ---
GMAIL_USERNAME=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- Python Chatbot Service ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
API_GATEWAY_URL=http://localhost:8080/api
