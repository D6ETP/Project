# ============================================================
#   EasyTravel Frontend - Environment Variables TEMPLATE
#   Copy this file to .env.local for local development.
#   For Vercel: set these in Vercel Dashboard ->
#   Project Settings -> Environment Variables
# ============================================================

# Backend API Gateway URL
# Local dev:     http://localhost:8080/api
# Vercel (prod): https://<your-ec2-or-server-domain>/api
VITE_API_BASE_URL=http://localhost:8080/api

# Chatbot Service URL
# Local dev:     http://localhost:8085
# Vercel (prod): https://<your-ec2-or-server-domain>:8085
VITE_CHATBOT_URL=http://localhost:8085
