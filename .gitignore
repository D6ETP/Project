# ============================================================
#   EasyTravel - .gitignore
#   Covers: Spring Boot, React, Python, .NET, secrets
# ============================================================

# ── Secrets (NEVER commit) ───────────────────────────────
.env

# ── Java / Spring Boot / Maven ───────────────────────────
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/mvnw.cmd

# Spring Boot packaged jars
*.jar
*.war
*.ear

# Spring log files
*.log
**/logs/

# ── React / Node (Frontend) ──────────────────────────────
**/node_modules/
**/dist/
**/build/
frontend/.env
frontend/.env.local
frontend/.env.production

# ── Python (chatbot-service) ─────────────────────────────
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.Python
**/pip-log.txt

# ── .NET (LoggingService) ────────────────────────────────
**/bin/
**/obj/
*.user
*.suo
*.sln.docstates
.vs/

# ── IDE & OS files ───────────────────────────────────────
**/.vscode/
**/.idea/
**/*.iml
.DS_Store
Thumbs.db
desktop.ini

# ── Eclipse (if any) ─────────────────────────────────────
**/.metadata/
**/.classpath
**/.project
**/.settings/