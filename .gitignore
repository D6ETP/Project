# EasyTravel .gitignore
# Covers: Spring Boot, React, Python, .NET, secrets

# Secrets (NEVER commit)
.env
.env.example

# Java / Spring Boot / Maven
**/target/
**/.mvn/wrapper/maven-wrapper.jar
**/mvnw.cmd

# Spring Boot packaged jars
*.jar
*.war
*.ear

# Spring log files
*.log
**/logs/

# React / Node (Frontend)
**/node_modules/